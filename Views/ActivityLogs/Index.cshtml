@model IEnumerable<UserSystem.Models.ActivityLog>

@{
    ViewBag.Title = "Activity Logs";
}

<h2>Activity Logs</h2>

<table class="table table-striped table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>Timestamp</th>
            <th>User</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var log in Model)
        {
            <tr>
                <td>@log.TimestampUtc</td>
                <td>@log.UserId</td>
                <td>@log.Action</td>
            </tr>
        }
    </tbody>
</table>
