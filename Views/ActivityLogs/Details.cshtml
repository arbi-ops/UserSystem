@model UserSystem.Models.ActivityLog

@{
    ViewBag.Title = "Activity Log Details";
}

<h2>Activity Log Details</h2>

<div>
    <dl class="row">
        <dt class="col-sm-2">Timestamp</dt>
        <dd class="col-sm-10">@Model.TimestampUtc</dd>

        <dt class="col-sm-2">User</dt>
        <dd class="col-sm-10">@Model.UserId</dd>

        <dt class="col-sm-2">Action</dt>
        <dd class="col-sm-10">@Model.Action</dd>
    </dl>
</div>

<p>
    @Html.ActionLink("Back to List", "Index")
</p>
